# =====================================================
# Copie este arquivo para ".env" e ajuste os valores
# =====================================================

# Servidor
PORT=3000
NODE_ENV=development
# URL pública do site (usada no SEO / Open Graph / sitemap)
APP_URL=http://localhost:3000
# Fuso horário usado para calcular "hoje" e horários livres
TZ_APP=America/Sao_Paulo

# Sessão (troque por um texto aleatório e longo em produção)
SESSION_SECRET=troque-este-segredo-por-um-texto-bem-grande
# "true" somente quando o site estiver em HTTPS
COOKIE_SECURE=false

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dbbarber
DB_USER=root
DB_PASSWORD=
# Coloque "true" para ver os SQLs no terminal (útil para estudar)
DB_LOGGING=false
# "true" recria/ajusta colunas ao rodar "npm run db:sync" (use apenas em desenvolvimento)
DB_ALTER=false

# Usuário administrador criado pelo seeder
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=12345678

# Cria barbeiros, serviços e produtos de exemplo junto com o admin (true/false)
SEED_DEMO=true
