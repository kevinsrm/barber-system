<div class="w-full max-w-md">
    <div class="text-center mb-6">
        <span class="w-14 h-14 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center mx-auto mb-3">
            <i class="bi bi-person-plus text-2xl"></i>
        </span>
        <h1 class="text-2xl sm:text-3xl font-black text-white">Criar sua conta</h1>
        <p class="text-sm text-zinc-400 mt-1">É rápido. Depois você agenda e acompanha tudo por aqui.</p>
    </div>

    {{#if mensagem}}
    <div class="alerta alerta-erro mb-4"><i class="bi bi-exclamation-triangle"></i><span>{{mensagem}}</span></div>
    {{/if}}

    <form method="POST" action="/cadastro" class="cartao p-6 space-y-4">
        <div>
            <label for="name" class="rotulo">Nome completo</label>
            <input type="text" id="name" name="name" value="{{valores.nome}}" required autocomplete="name" class="campo" placeholder="Seu nome">
        </div>

        <div>
            <label for="email" class="rotulo">E-mail</label>
            <input type="email" id="email" name="email" value="{{valores.email}}" required autocomplete="email" class="campo" placeholder="seu@email.com">
        </div>

        <div>
            <label for="telefone" class="rotulo">WhatsApp (opcional)</label>
            <input type="tel" id="telefone" name="telefone" value="{{valores.telefone}}" class="campo" placeholder="(98) 99999-9999">
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
                <label for="password" class="rotulo">Senha</label>
                <input type="password" id="password" name="password" required minlength="8" autocomplete="new-password" class="campo" placeholder="Mínimo 8 caracteres">
            </div>
            <div>
                <label for="confirmarSenha" class="rotulo">Confirmar senha</label>
                <input type="password" id="confirmarSenha" name="confirmarSenha" required minlength="8" autocomplete="new-password" class="campo" placeholder="Repita a senha">
            </div>
        </div>

        <button type="submit" class="botao botao-primario w-full py-3">
            Criar conta <i class="bi bi-arrow-right"></i>
        </button>
    </form>

    <p class="text-center text-sm text-zinc-400 mt-4">
        Já tem conta?
        <a href="/login" class="text-amber-400 font-semibold hover:underline">Entrar</a>
    </p>
    <p class="text-center text-xs text-zinc-500 mt-2">
        <a href="/" class="hover:text-amber-400 inline-flex items-center gap-1"><i class="bi bi-arrow-left"></i> Voltar ao site</a>
    </p>
</div>
