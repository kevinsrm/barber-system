<div class="w-full max-w-md">
    <div class="text-center mb-6">
        <span class="w-14 h-14 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center mx-auto mb-3">
            <i class="bi bi-box-arrow-in-right text-2xl"></i>
        </span>
        <h1 class="text-2xl sm:text-3xl font-black text-white">Acesse sua conta</h1>
        <p class="text-sm text-zinc-400 mt-1">Entre para agendar, gerenciar ou acompanhar seus horários.</p>
    </div>

    {{#if mensagem}}
    <div class="alerta alerta-erro mb-4"><i class="bi bi-exclamation-triangle"></i><span>{{mensagem}}</span></div>
    {{/if}}

    <form method="POST" action="/login" class="cartao p-6 space-y-4">
        <div>
            <label for="email" class="rotulo">E-mail</label>
            <div class="relative">
                <i class="bi bi-envelope absolute left-3 top-1/2 -translate-y-1/2 text-zinc-500 text-sm"></i>
                <input type="email" id="email" name="email" value="{{email}}" required autocomplete="email" class="campo pl-9" placeholder="seu@email.com">
            </div>
        </div>

        <div>
            <label for="password" class="rotulo">Senha</label>
            <div class="relative">
                <i class="bi bi-lock absolute left-3 top-1/2 -translate-y-1/2 text-zinc-500 text-sm"></i>
                <input type="password" id="password" name="password" required autocomplete="current-password" class="campo pl-9" placeholder="••••••••">
            </div>
        </div>

        <button type="submit" class="botao botao-primario w-full py-3">
            Entrar <i class="bi bi-arrow-right"></i>
        </button>
    </form>

    <p class="text-center text-sm text-zinc-400 mt-4">
        Não tem uma conta?
        <a href="/cadastro" class="text-amber-400 font-semibold hover:underline">Criar conta</a>
    </p>
    <p class="text-center text-xs text-zinc-500 mt-2">
        <a href="/" class="hover:text-amber-400 inline-flex items-center gap-1"><i class="bi bi-arrow-left"></i> Voltar ao site</a>
    </p>
    <p class="text-center text-[11px] text-zinc-600 mt-6">
        Barbeiros e administradores usam o mesmo login, criado pelo administrador do sistema.
    </p>
</div>
