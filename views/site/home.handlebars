<!-- HERO -->
<section class="relative overflow-hidden bg-gradient-to-br from-zinc-950 via-zinc-900 to-black border-b border-zinc-800/60">
    <div class="absolute inset-0 opacity-[0.07] bg-[radial-gradient(#f59e0b_1px,transparent_1px)] [background-size:18px_18px] pointer-events-none"></div>
    <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-amber-500/10 blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-16 lg:py-24 relative">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
            <div class="lg:col-span-7 space-y-6 aparecer">
                <span class="inline-flex items-center gap-2 bg-amber-500/10 border border-amber-500/20 text-amber-400 text-[11px] font-semibold px-3.5 py-1.5 rounded-full uppercase tracking-wider">
                    <i class="bi bi-award-fill"></i> {{site.slogan}}
                </span>

                <h1 class="text-4xl sm:text-5xl xl:text-6xl font-black tracking-tight leading-[1.05] text-white">
                    {{site.heroTitulo}}
                </h1>

                <p class="text-base sm:text-lg text-zinc-300 max-w-xl font-light leading-relaxed">
                    {{site.heroSubtitulo}}
                </p>

                <div class="flex flex-wrap gap-3 pt-1">
                    <a href="/agendar" class="botao botao-primario px-7 py-3.5 text-base">
                        <i class="bi bi-calendar-check-fill"></i> Agendar horário
                    </a>
                    <a href="/servicos" class="botao botao-secundario px-7 py-3.5 text-base">
                        Ver serviços e preços
                    </a>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-6 border-t border-zinc-800/80">
                    <div class="flex items-center gap-2.5">
                        <span class="w-9 h-9 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center shrink-0"><i class="bi bi-clock-history"></i></span>
                        <span class="text-xs text-zinc-300">{{site.horarioFuncionamento}}</span>
                    </div>
                    <div class="flex items-center gap-2.5">
                        <span class="w-9 h-9 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center shrink-0"><i class="bi bi-scissors"></i></span>
                        <span class="text-xs text-zinc-300">Profissionais qualificados</span>
                    </div>
                    <div class="flex items-center gap-2.5">
                        <span class="w-9 h-9 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center shrink-0"><i class="bi bi-geo-alt-fill"></i></span>
                        <span class="text-xs text-zinc-300">{{#if site.endereco}}{{site.endereco}}{{else}}Venha nos visitar{{/if}}</span>
                    </div>
                </div>
            </div>

            <div class="hidden lg:flex lg:col-span-5 justify-center relative aparecer">
                <div class="absolute inset-0 bg-gradient-to-tr from-amber-500/15 to-transparent blur-3xl rounded-full"></div>
                <div class="relative w-full max-w-sm bg-gradient-to-b from-zinc-900 to-zinc-950 border border-zinc-800 rounded-3xl shadow-2xl p-8">
                    <div class="flex items-center justify-center mb-6">
                        {{#if site.logo}}
                            <img src="{{site.logo}}" alt="Logo {{site.nome}}" class="h-28 w-auto max-w-[220px] object-contain">
                        {{else}}
                            <span class="w-32 h-32 rounded-full bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400">
                                <i class="bi bi-scissors" style="font-size: 4.5rem;"></i>
                            </span>
                        {{/if}}
                    </div>
                    <p class="text-center text-xl font-black text-white">{{site.nome}}</p>
                    <p class="text-center text-xs uppercase tracking-[0.2em] text-zinc-500 mt-1">{{site.slogan}}</p>
                    <div class="mt-6 space-y-2 text-sm">
                        <div class="flex items-center justify-between text-zinc-400"><span><i class="bi bi-check-circle text-amber-500 mr-2"></i>Agendamento online</span><span class="text-amber-400 font-semibold">24h</span></div>
                        <div class="flex items-center justify-between text-zinc-400"><span><i class="bi bi-check-circle text-amber-500 mr-2"></i>Cancelamento fácil</span><span class="text-amber-400 font-semibold">Grátis</span></div>
                        <div class="flex items-center justify-between text-zinc-400"><span><i class="bi bi-check-circle text-amber-500 mr-2"></i>Produtos premium</span><span class="text-amber-400 font-semibold">Incluso</span></div>
                    </div>
                    <a href="/agendar" class="botao botao-primario w-full mt-6">Reservar meu horário</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SERVIÇOS -->
<section id="servicos" class="py-14 sm:py-16 bg-zinc-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-8">
            <div>
                <p class="text-[11px] font-semibold uppercase tracking-widest text-amber-500">Nossos serviços</p>
                <h2 class="text-2xl sm:text-3xl font-black text-white mt-1">Cuidado completo para o seu estilo</h2>
                <p class="text-sm text-zinc-400 mt-1">Valores e duração de cada procedimento.</p>
            </div>
            <a href="/servicos" class="botao botao-secundario shrink-0">Ver todos <i class="bi bi-arrow-right"></i></a>
        </div>

        {{#if servicos.length}}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
            {{#each servicos}}
            <article class="cartao p-5 flex flex-col justify-between hover:border-amber-500/40 transition group">
                <div>
                    <div class="flex items-start justify-between gap-3 mb-3">
                        <span class="w-11 h-11 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center group-hover:bg-amber-500 group-hover:text-zinc-950 transition">
                            <i class="bi {{#if icone}}{{icone}}{{else}}bi-scissors{{/if}}"></i>
                        </span>
                        <span class="text-xl font-black text-amber-400">{{moeda preco}}</span>
                    </div>
                    <p class="text-[11px] uppercase tracking-wider text-zinc-500">{{#if categoria}}{{categoria.nome}}{{else}}Serviço{{/if}}</p>
                    <h3 class="text-lg font-bold text-white mt-0.5">{{nome}}</h3>
                    <p class="text-sm text-zinc-400 mt-2 leading-relaxed">{{descricao}}</p>
                </div>
                <div class="flex items-center justify-between pt-4 mt-4 border-t border-zinc-800">
                    <span class="text-xs text-zinc-500"><i class="bi bi-clock"></i> {{duracao}} min</span>
                    <a href="/agendar?servico={{id}}" class="text-xs font-semibold text-amber-400 hover:text-amber-300 inline-flex items-center gap-1">
                        Agendar <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </article>
            {{/each}}
        </div>
        {{else}}
        <div class="cartao p-8 text-center max-w-lg mx-auto">
            <i class="bi bi-journal-x text-3xl text-zinc-600 block mb-2"></i>
            <p class="text-sm text-zinc-400">Nossos serviços estão sendo atualizados. Fale com a gente para mais informações.</p>
            <a href="/agendar" class="botao botao-primario mt-4">Fazer agendamento</a>
        </div>
        {{/if}}
    </div>
</section>

<!-- COMO FUNCIONA -->
<section id="como-funciona" class="py-14 sm:py-16 bg-zinc-900/40 border-y border-zinc-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-10">
            <p class="text-[11px] font-semibold uppercase tracking-widest text-amber-500">Simples e rápido</p>
            <h2 class="text-2xl sm:text-3xl font-black text-white mt-1">Como funciona</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <article class="cartao p-6 text-center">
                <span class="w-14 h-14 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center mx-auto mb-4 text-2xl"><i class="bi bi-calendar-plus"></i></span>
                <h3 class="font-semibold text-white">1. Escolha o horário</h3>
                <p class="text-sm text-zinc-400 mt-2 leading-relaxed">Selecione o serviço, o profissional e o horário livre que preferir.</p>
            </article>
            <article class="cartao p-6 text-center">
                <span class="w-14 h-14 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center mx-auto mb-4 text-2xl"><i class="bi bi-person-check"></i></span>
                <h3 class="font-semibold text-white">2. Confirmação rápida</h3>
                <p class="text-sm text-zinc-400 mt-2 leading-relaxed">A barbearia confirma seu agendamento e você recebe o lembrete.</p>
            </article>
            <article class="cartao p-6 text-center">
                <span class="w-14 h-14 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center mx-auto mb-4 text-2xl"><i class="bi bi-star"></i></span>
                <h3 class="font-semibold text-white">3. Atendimento pontual</h3>
                <p class="text-sm text-zinc-400 mt-2 leading-relaxed">Chegou, foi atendido. Sem fila e sem espera desnecessária.</p>
            </article>
        </div>
    </div>
</section>

<!-- EQUIPE -->
{{#if funcionarios.length}}
<section class="py-14 sm:py-16 bg-zinc-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-8">
            <p class="text-[11px] font-semibold uppercase tracking-widest text-amber-500">Nosso time</p>
            <h2 class="text-2xl sm:text-3xl font-black text-white mt-1">Quem cuida do seu visual</h2>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
            {{#each funcionarios}}
            <article class="cartao p-5 text-center">
                <span class="w-16 h-16 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-lg font-black flex items-center justify-center mx-auto mb-3">{{iniciais nome}}</span>
                <h3 class="text-sm font-semibold text-white">{{nome}}</h3>
                <p class="text-xs text-zinc-500 mt-0.5">{{#if cargo}}{{cargo.nome}}{{else}}Barbeiro{{/if}}</p>
            </article>
            {{/each}}
        </div>
    </div>
</section>
{{/if}}

<!-- SOBRE -->
<section id="sobre" class="py-14 sm:py-16 bg-zinc-900/40 border-y border-zinc-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div>
            <p class="text-[11px] font-semibold uppercase tracking-widest text-amber-500">Sobre nós</p>
            <h2 class="text-2xl sm:text-3xl font-black text-white mt-1">Mais que um corte, uma experiência</h2>
            <p class="text-sm sm:text-base text-zinc-300 mt-4 leading-relaxed">{{site.sobre}}</p>

            <div class="mt-6 flex flex-wrap gap-3">
                {{#if whatsappLink}}<a href="{{whatsappLink}}" target="_blank" rel="noopener" class="botao botao-secundario"><i class="bi bi-whatsapp text-emerald-400"></i> WhatsApp</a>{{/if}}
                {{#if site.instagram}}<a href="{{site.instagram}}" target="_blank" rel="noopener" class="botao botao-secundario"><i class="bi bi-instagram text-pink-400"></i> Instagram</a>{{/if}}
                <a href="/agendar" class="botao botao-primario"><i class="bi bi-calendar-check"></i> Agendar agora</a>
            </div>
        </div>

        <div class="cartao p-6 space-y-4">
            <h3 class="font-semibold text-white">Informações da barbearia</h3>
            {{#if site.endereco}}<p class="flex items-start gap-3 text-sm text-zinc-300"><i class="bi bi-geo-alt text-amber-500 mt-0.5"></i><span>{{site.endereco}}</span></p>{{/if}}
            {{#if site.telefone}}<p class="flex items-start gap-3 text-sm text-zinc-300"><i class="bi bi-telephone text-amber-500 mt-0.5"></i><a href="tel:{{site.telefone}}" class="hover:text-amber-400">{{site.telefone}}</a></p>{{/if}}
            {{#if site.email}}<p class="flex items-start gap-3 text-sm text-zinc-300"><i class="bi bi-envelope text-amber-500 mt-0.5"></i><a href="mailto:{{site.email}}" class="hover:text-amber-400 break-all">{{site.email}}</a></p>{{/if}}
            <p class="flex items-start gap-3 text-sm text-zinc-300"><i class="bi bi-clock text-amber-500 mt-0.5"></i><span>{{site.horarioFuncionamento}}</span></p>
            <div class="pt-4 border-t border-zinc-800">
                <a href="/servicos" class="text-sm text-amber-400 hover:text-amber-300 inline-flex items-center gap-1">Conhecer serviços e preços <i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
</section>

<!-- DEPOIMENTOS -->
{{#if comentarios.length}}
<section class="py-14 sm:py-16 bg-zinc-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-8">
            <p class="text-[11px] font-semibold uppercase tracking-widest text-amber-500">Depoimentos</p>
            <h2 class="text-2xl sm:text-3xl font-black text-white mt-1">O que nossos clientes dizem</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {{#each comentarios}}
            <article class="cartao p-5">
                <div class="flex items-center gap-1 text-amber-400 text-xs mb-3">
                    {{#times nota}}<i class="bi bi-star-fill"></i>{{/times}}
                </div>
                <p class="text-sm text-zinc-300 leading-relaxed">“{{texto}}”</p>
                <div class="flex items-center gap-2 mt-4 pt-4 border-t border-zinc-800">
                    <span class="w-8 h-8 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-[10px] font-bold flex items-center justify-center">{{iniciais nome}}</span>
                    <span class="text-xs text-zinc-400">{{nome}}</span>
                </div>
            </article>
            {{/each}}
        </div>
    </div>
</section>
{{/if}}

<!-- CTA FINAL -->
<section class="py-14 sm:py-16 bg-gradient-to-r from-amber-500/10 via-zinc-950 to-zinc-950 border-t border-amber-500/20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <h2 class="text-2xl sm:text-3xl font-black text-white">Pronto para dar um upgrade no seu visual?</h2>
        <p class="text-sm sm:text-base text-zinc-400 mt-2 max-w-xl mx-auto">Escolha o melhor horário, garanta seu atendimento sem filas e saia daqui com o estilo renovado.</p>
        <a href="/agendar" class="botao botao-primario px-8 py-3.5 text-base mt-6"><i class="bi bi-calendar-check-fill"></i> Agendar meu horário</a>
    </div>
</section>
