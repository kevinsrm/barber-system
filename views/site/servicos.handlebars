<section class="relative overflow-hidden bg-gradient-to-br from-zinc-950 via-zinc-900 to-black border-b border-zinc-800/60">
    <div class="absolute inset-0 opacity-[0.07] bg-[radial-gradient(#f59e0b_1px,transparent_1px)] [background-size:18px_18px] pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-14 sm:py-20 relative text-center">
        <span class="inline-flex items-center gap-2 bg-amber-500/10 border border-amber-500/20 text-amber-400 text-[11px] font-semibold px-3.5 py-1.5 rounded-full uppercase tracking-wider">
            <i class="bi bi-scissors"></i> Tabela de preços e procedimentos
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-white mt-5">Nossos serviços</h1>
        <p class="text-sm sm:text-base text-zinc-400 max-w-2xl mx-auto mt-3 leading-relaxed">
            Cortes, barba e tratamentos masculinos realizados por profissionais qualificados. Escolha o serviço e agende em menos de um minuto.
        </p>
    </div>
</section>

<section class="py-12 sm:py-16 bg-zinc-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
        {{#if servicos.length}}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
            {{#each servicos}}
            <article class="cartao p-5 flex flex-col justify-between hover:border-amber-500/40 transition group">
                <div>
                    <div class="flex items-start justify-between gap-3 mb-3">
                        <span class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center text-lg group-hover:bg-amber-500 group-hover:text-zinc-950 transition">
                            <i class="bi {{#if icone}}{{icone}}{{else}}bi-scissors{{/if}}"></i>
                        </span>
                        <span class="text-2xl font-black text-amber-400">{{moeda preco}}</span>
                    </div>
                    <p class="text-[11px] uppercase tracking-wider text-zinc-500">{{#if categoria}}{{categoria.nome}}{{else}}Serviço{{/if}}</p>
                    <h2 class="text-xl font-bold text-white mt-0.5">{{nome}}</h2>
                    <p class="text-sm text-zinc-400 mt-2 leading-relaxed">{{descricao}}</p>
                </div>
                <div class="flex items-center justify-between pt-4 mt-4 border-t border-zinc-800">
                    <span class="text-xs text-zinc-500"><i class="bi bi-clock"></i> {{duracao}} min</span>
                    <a href="/agendar?servico={{id}}" class="botao botao-primario botao-mini">Agendar <i class="bi bi-arrow-right"></i></a>
                </div>
            </article>
            {{/each}}
        </div>
        {{else}}
        <div class="cartao p-10 text-center max-w-lg mx-auto">
            <span class="w-16 h-16 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-400 flex items-center justify-center mx-auto mb-4 text-3xl"><i class="bi bi-journal-x"></i></span>
            <h2 class="text-xl font-bold text-white">Nenhum serviço disponível no momento</h2>
            <p class="text-sm text-zinc-400 mt-2">Estamos atualizando nosso catálogo. Entre em contato ou faça um agendamento direto.</p>
            <a href="/agendar" class="botao botao-primario mt-5">Ir para o agendamento</a>
        </div>
        {{/if}}
    </div>
</section>

<section class="bg-gradient-to-r from-zinc-900 via-zinc-950 to-zinc-900 border-t border-zinc-800 py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <h2 class="text-2xl sm:text-3xl font-black text-white">Pronto para dar um upgrade no seu visual?</h2>
        <p class="text-sm sm:text-base text-zinc-400 mt-2 max-w-xl mx-auto">Escolha o horário mais conveniente e garanta seu atendimento sem filas.</p>
        <a href="/agendar" class="botao botao-primario px-8 py-3.5 mt-5"><i class="bi bi-calendar-check-fill"></i> Agendar agora</a>
    </div>
</section>
