<!-- HERO DA PÁGINA DE SERVIÇOS -->
<section class="relative bg-gradient-to-br from-zinc-950 via-zinc-900 to-black text-white py-16 lg:py-24 overflow-hidden border-b border-zinc-800/60">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#d4af37_1px,transparent_1px)] [background-size:16px_16px] pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-6 relative z-10 text-center">
        <div class="inline-flex items-center gap-2 bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-semibold px-3.5 py-1.5 rounded-full uppercase tracking-wider mb-4">
            <i class="bi bi-scissors"></i> Tabela de Preços & Procedimentos
        </div>
        <h1 class="text-4xl sm:text-5xl font-black tracking-tight leading-none mb-4">
            Nossos <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-amber-600">Serviços</span>
        </h1>
        <p class="text-zinc-400 max-w-2xl mx-auto text-base sm:text-lg font-light">
            Confira nossa linha completa de cortes, tratamentos de barba e cuidados masculinos premium. Tudo realizado por profissionais qualificados.
        </p>
    </div>
</section>

<!-- SEÇÃO PRINCIPAL DE SERVIÇOS -->
<section class="bg-zinc-950 py-16 min-h-[500px]">
    <div class="max-w-7xl mx-auto px-6">

        {{#if servicos.length}}
            <!-- LISTA DINÂMICA DE SERVIÇOS -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {{#each servicos}}
                    <div class="bg-gradient-to-b from-zinc-900 to-zinc-900/60 border border-zinc-800 hover:border-amber-500/40 rounded-2xl p-6 transition-all duration-300 hover:-translate-y-1 shadow-xl flex flex-col justify-between group">
                        <div>
                            <div class="flex items-start justify-between gap-4 mb-4">
                                <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 text-xl group-hover:bg-amber-500 group-hover:text-zinc-950 transition-colors duration-300">
                                    <i class="bi {{#if icon}}{{icon}}{{else}}bi-scissors{{/if}}"></i>
                                </div>
                                <span class="text-2xl font-black text-amber-400 tracking-tight">
                                    R$ {{preco}}
                                </span>
                            </div>

                            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-amber-400 transition-colors">
                                {{nome}}
                            </h3>

                            <p class="text-zinc-400 text-sm font-light leading-relaxed mb-6">
                                {{descricao}}
                            </p>
                        </div>

                        <div class="pt-4 border-t border-zinc-800/80 flex items-center justify-between">
                            <span class="text-xs text-zinc-500 font-medium inline-flex items-center gap-1.5">
                                <i class="bi bi-clock"></i> {{duracao}} min
                            </span>
                            <a href="/agendar?servico={{id}}" class="text-xs font-semibold text-amber-400 hover:text-amber-300 inline-flex items-center gap-1 transition-colors">
                                Agendar este <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                {{/each}}
            </div>

        {{else}}
            <!-- MENSAGEM AMIGÁVEL QUANDO NÃO HÁ SERVIÇOS NO BANCO -->
            <div class="max-w-md mx-auto text-center py-12 px-6 bg-zinc-900/50 border border-zinc-800 rounded-3xl backdrop-blur-sm">
                <div class="w-16 h-16 bg-amber-500/10 border border-amber-500/20 text-amber-400 rounded-2xl flex items-center justify-center mx-auto mb-4 text-3xl">
                    <i class="bi bi-journal-x"></i>
                </div>
                <h3 class="text-xl font-bold text-white mb-2">Nenhum serviço disponível no momento</h3>
                <p class="text-zinc-400 text-sm font-light mb-6 leading-relaxed">
                    Estamos atualizando nosso catálogo de serviços e tabela de preços. Entre em contato conosco ou faça um agendamento direto.
                </p>
                <a href="/agendar" class="bg-amber-500 hover:bg-amber-400 text-zinc-950 font-bold px-6 py-3 rounded-xl shadow-lg shadow-amber-500/10 transition-all duration-300 inline-flex items-center justify-center gap-2 text-sm">
                    <i class="bi bi-calendar-check-fill"></i> Ir para Agendamento
                </a>
            </div>
        {{/if}}

    </div>
</section>

<!-- CALL TO ACTION FIXO -->
<section class="bg-gradient-to-r from-zinc-900 via-zinc-950 to-zinc-900 border-t border-zinc-800 py-12">
    <div class="max-w-5xl mx-auto px-6 text-center space-y-4">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Pronto para dar um upgrade no seu visual?</h2>
        <p class="text-zinc-400 text-sm sm:text-base max-w-xl mx-auto font-light">
            Escolha o horário mais conveniente para você e garanta seu atendimento sem filas.
        </p>
        <div class="pt-2">
            <a href="/agendar" class="bg-amber-500 hover:bg-amber-400 text-zinc-950 font-bold px-8 py-3.5 rounded-xl transition-all duration-300 inline-flex items-center gap-2 transform hover:-translate-y-0.5">
                <i class="bi bi-calendar-check-fill"></i> Agendar Agora
            </a>
        </div>
    </div>
</section>
