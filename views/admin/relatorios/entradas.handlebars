<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-5">
    <div>
        <p class="text-[11px] font-semibold uppercase tracking-widest text-amber-500">Relatórios</p>
        <h2 class="text-xl sm:text-2xl font-bold text-white">Entradas / ganhos</h2>
        <p class="text-sm text-zinc-500 mt-0.5">De {{data inicio}} a {{data fim}}</p>
    </div>
    <div class="flex gap-2 nao-imprimir">
        <a href="/admin/relatorios" class="botao botao-secundario"><i class="bi bi-arrow-left"></i> Voltar</a>
        <button type="button" onclick="window.print()" class="botao botao-secundario"><i class="bi bi-printer"></i> Imprimir</button>
    </div>
</div>

{{> admin/filtro-periodo}}

<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-5">
    <div class="cartao p-4">
        <p class="text-[11px] uppercase tracking-wider text-zinc-500">Serviços</p>
        <p class="text-xl font-bold text-zinc-100 mt-1">{{moeda totais.servicos}}</p>
    </div>
    <div class="cartao p-4">
        <p class="text-[11px] uppercase tracking-wider text-zinc-500">Produtos</p>
        <p class="text-xl font-bold text-zinc-100 mt-1">{{moeda totais.produtos}}</p>
    </div>
    <div class="cartao p-4">
        <p class="text-[11px] uppercase tracking-wider text-zinc-500">Outras receitas</p>
        <p class="text-xl font-bold text-zinc-100 mt-1">{{moeda totais.outros}}</p>
    </div>
    <div class="cartao p-4 border-emerald-500/30">
        <p class="text-[11px] uppercase tracking-wider text-zinc-500">Total</p>
        <p class="text-xl font-black text-emerald-400 mt-1">{{moeda totais.geral}}</p>
    </div>
</div>

<section class="cartao overflow-hidden mb-4 cartao-impressao">
    <div class="cartao-cabecalho"><h3 class="font-semibold text-white">Serviços concluídos</h3></div>
    <div class="overflow-x-auto">
        <table class="tabela min-w-[640px]">
            <thead><tr><th>Data</th><th>Cliente</th><th>Barbeiro</th><th class="numero">Valor</th></tr></thead>
            <tbody>
                {{#each agendamentos}}
                <tr>
                    <td>{{data data}}</td>
                    <td class="text-zinc-100">{{cliente.nome}}</td>
                    <td>{{funcionario.nome}}</td>
                    <td class="numero font-semibold">{{moeda valorTotal}}</td>
                </tr>
                {{else}}
                <tr><td colspan="4"><div class="tabela-vazia">Nenhum serviço concluído no período.</div></td></tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</section>

<section class="cartao overflow-hidden mb-4 cartao-impressao">
    <div class="cartao-cabecalho"><h3 class="font-semibold text-white">Vendas de produtos</h3></div>
    <div class="overflow-x-auto">
        <table class="tabela min-w-[640px]">
            <thead><tr><th>Data</th><th>Cliente</th><th>Itens</th><th class="numero">Valor</th></tr></thead>
            <tbody>
                {{#each vendas}}
                <tr>
                    <td>{{data data}}</td>
                    <td>{{#if cliente}}{{cliente.nome}}{{else}}Consumidor final{{/if}}</td>
                    <td class="text-xs text-zinc-500">{{#each itens}}{{quantidade}}x {{descricao}}{{#unless @last}}, {{/unless}}{{/each}}</td>
                    <td class="numero font-semibold">{{moeda valorTotal}}</td>
                </tr>
                {{else}}
                <tr><td colspan="4"><div class="tabela-vazia">Nenhuma venda no período.</div></td></tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</section>

<section class="cartao overflow-hidden cartao-impressao">
    <div class="cartao-cabecalho"><h3 class="font-semibold text-white">Contas recebidas</h3></div>
    <div class="overflow-x-auto">
        <table class="tabela min-w-[640px]">
            <thead><tr><th>Data</th><th>Descrição</th><th class="numero">Valor</th></tr></thead>
            <tbody>
                {{#each contas}}
                <tr>
                    <td>{{data dataPagamento}}</td>
                    <td class="text-zinc-100">{{descricao}}</td>
                    <td class="numero font-semibold">{{moeda valor}}</td>
                </tr>
                {{else}}
                <tr><td colspan="3"><div class="tabela-vazia">Nenhuma conta recebida no período.</div></td></tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</section>
