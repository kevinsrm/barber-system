<div class="flex min-h-screen bg-gray-100 relative overflow-x-hidden">
  <!-- Botão para abrir/fechar o menu -->
  <button onclick="toggleMenu(event)" class="absolute top-4 left-4 z-50 bg-slate-900 text-white p-2 rounded-lg shadow cursor-pointer">
    <i class="bi bi-list text-xl"></i>
  </button>

  <!-- Sidenav -->
  <aside id="sidenav" class="w-64 bg-slate-900 text-slate-300 flex flex-col shrink-0 transition-all duration-300 fixed md:static inset-y-0 left-0 z-40 -translate-x-full md:translate-x-0">
    <div class="p-5 border-b border-slate-800 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <i class="bi bi-layers-fill text-blue-500 text-xl"></i>
        <span class="font-bold text-white text-lg">Meu Painel</span>
      </div>
    </div>

    <nav class="flex flex-col gap-1 p-3">
      <button onclick="switchTab(event, 'inicio')" class="nav-btn active flex items-center gap-3 px-4 py-3 rounded-lg text-slate-400 hover:bg-slate-800 hover:text-white transition">
        <i class="bi bi-house-door text-lg"></i>
        <span>Início</span>
      </button>

      <button onclick="switchTab(event, 'dashboard')" class="nav-btn flex items-center gap-3 px-4 py-3 rounded-lg text-slate-400 hover:bg-slate-800 hover:text-white transition">
        <i class="bi bi-speedometer2 text-lg"></i>
        <span>Dashboard</span>
      </button>

      <button onclick="switchTab(event, 'projetos')" class="nav-btn flex items-center gap-3 px-4 py-3 rounded-lg text-slate-400 hover:bg-slate-800 hover:text-white transition">
        <i class="bi bi-folder2-open text-lg"></i>
        <span>Projetos</span>
      </button>

      <button onclick="switchTab(event, 'configuracoes')" class="nav-btn flex items-center gap-3 px-4 py-3 rounded-lg text-slate-400 hover:bg-slate-800 hover:text-white transition">
        <i class="bi bi-gear text-lg"></i>
        <span>Configurações</span>
      </button>
    </nav>
  </aside>

  <!-- Conteúdo das Telas -->
  <main class="flex-1 p-8 pt-16 md:pt-8 transition-all duration-300 w-full">
    <section id="inicio" class="tab-content block">
      <h1 class="text-2xl font-bold text-gray-800 mb-2">Início</h1>
      <p class="text-gray-600">Bem-vindo à tela inicial!</p>
    </section>

    <section id="dashboard" class="tab-content hidden">
      <h1 class="text-2xl font-bold text-gray-800 mb-2">Dashboard</h1>
      <p class="text-gray-600">Métricas e relatórios do sistema.</p>
    </section>

    <section id="projetos" class="tab-content hidden">
      <h1 class="text-2xl font-bold text-gray-800 mb-2">Projetos</h1>
      <p class="text-gray-600">Gerencie seus projetos ativos.</p>
    </section>

    <section id="configuracoes" class="tab-content hidden">
      <h1 class="text-2xl font-bold text-gray-800 mb-2">Configurações</h1>
      <p class="text-gray-600">Ajustes gerais do perfil e conta.</p>
    </section>
  </main>
</div>

<script>
  function switchTab(event, tabId) {
    document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
    document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('block'));

    document.querySelectorAll('.nav-btn').forEach(btn => {
      btn.classList.remove('bg-blue-600', 'text-white');
      btn.classList.add('text-slate-400');
    });

    document.getElementById(tabId).classList.remove('hidden');
    document.getElementById(tabId).classList.add('block');

    const activeBtn = event.currentTarget;
    activeBtn.classList.add('bg-blue-600', 'text-white');
    activeBtn.classList.remove('text-slate-400');
  }

  // Função para alternar o menu lateral
  function toggleMenu(event) {
    event.stopPropagation();
    const sidenav = document.getElementById('sidenav');
    
    if (window.innerWidth >= 768) {
      sidenav.classList.toggle('md:translate-x-0');
      sidenav.classList.toggle('-translate-x-full');
    } else {
      sidenav.classList.toggle('-translate-x-full');
    }
  }

  // Fecha o menu ao clicar fora em telas menores
  document.addEventListener('click', function(event) {
    const sidenav = document.getElementById('sidenav');
    const button = document.querySelector('button[onclick="toggleMenu(event)"]');
    const isClickInside = sidenav.contains(event.target) || button.contains(event.target);

    if (!isClickInside && window.innerWidth < 768) {
      sidenav.classList.add('-translate-x-full');
    }
  });

  // Define a primeira aba como ativa ao carregar
  document.querySelector('.nav-btn.active').classList.add('bg-blue-600', 'text-white');
</script>

