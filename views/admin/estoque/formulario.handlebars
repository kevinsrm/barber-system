<div class="max-w-xl mx-auto">
    <div class="flex items-center gap-3 mb-5">
        <a href="/admin/movimentos" class="botao botao-icone" title="Voltar"><i class="bi bi-arrow-left"></i></a>
        <div>
            <p class="text-[11px] font-semibold uppercase tracking-widest text-amber-500">Estoque</p>
            <h2 class="text-xl sm:text-2xl font-bold text-white">Nova movimentação</h2>
        </div>
    </div>

    {{#if mensagem}}
    <div class="alerta alerta-erro mb-4"><i class="bi bi-exclamation-triangle"></i><span>{{mensagem}}</span></div>
    {{/if}}

    <div class="alerta alerta-info mb-4">
        <i class="bi bi-info-circle"></i>
        <span>Entrada soma ao estoque (compra, devolução). Saída subtrai (uso interno, perda, venda avulsa).</span>
    </div>

    <form method="POST" action="/admin/movimentos" class="cartao p-5 space-y-4">
        <div>
            <label for="produtoId" class="rotulo">Produto <span class="text-amber-500">*</span></label>
            <select id="produtoId" name="produtoId" required class="campo-select">
                <option value="">Selecione...</option>
                {{#each produtos}}
                <option value="{{id}}" {{#if (eq ../dados.produtoId id)}}selected{{/if}}>{{nome}} (estoque: {{estoque}})</option>
                {{/each}}
            </select>
        </div>

        <div class="grid grid-cols-2 gap-3">
            <div>
                <label for="tipo" class="rotulo">Tipo <span class="text-amber-500">*</span></label>
                <select id="tipo" name="tipo" class="campo-select" required>
                    <option value="entrada" {{#if (eq dados.tipo 'entrada')}}selected{{/if}}>Entrada</option>
                    <option value="saida" {{#if (eq dados.tipo 'saida')}}selected{{/if}}>Saída</option>
                </select>
            </div>
            <div>
                <label for="quantidade" class="rotulo">Quantidade <span class="text-amber-500">*</span></label>
                <input type="number" id="quantidade" name="quantidade" min="1" step="1" value="{{#if dados.quantidade}}{{dados.quantidade}}{{else}}1{{/if}}" required class="campo">
            </div>
        </div>

        <div>
            <label for="data" class="rotulo">Data <span class="text-amber-500">*</span></label>
            <input type="date" id="data" name="data" value="{{dados.data}}" required class="campo">
        </div>

        <div>
            <label for="motivo" class="rotulo">Motivo</label>
            <input type="text" id="motivo" name="motivo" value="{{dados.motivo}}" class="campo" placeholder="Ex.: compra do fornecedor, uso interno...">
        </div>

        <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 pt-4 border-t border-zinc-800">
            <a href="/admin/movimentos" class="botao botao-secundario">Cancelar</a>
            <button type="submit" class="botao botao-primario"><i class="bi bi-check2"></i> Registrar</button>
        </div>
    </form>
</div>
