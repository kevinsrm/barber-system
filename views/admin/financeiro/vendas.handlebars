<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-5">
    <div>
        <p class="text-[11px] font-semibold uppercase tracking-widest text-amber-500">Financeiro</p>
        <h2 class="text-xl sm:text-2xl font-bold text-white">Vendas de produtos</h2>
        <p class="text-sm text-zinc-500 mt-0.5">Vendas registradas no balcão.</p>
    </div>
    <a href="/admin/vendas/nova" class="botao botao-primario"><i class="bi bi-plus-lg"></i> Nova venda</a>
</div>

{{> admin/filtro-periodo}}

<div class="grid grid-cols-2 gap-3 mb-4">
    <div class="cartao p-4">
        <p class="text-[11px] uppercase tracking-wider text-zinc-500">Vendas no período</p>
        <p class="text-xl font-bold text-white mt-1">{{quantidade}}</p>
    </div>
    <div class="cartao p-4">
        <p class="text-[11px] uppercase tracking-wider text-zinc-500">Total vendido</p>
        <p class="text-xl font-bold text-emerald-400 mt-1">{{moeda total}}</p>
    </div>
</div>

<div class="cartao overflow-hidden">
    <div class="overflow-x-auto">
        <table class="tabela min-w-[760px]">
            <thead>
                <tr>
                    <th>Data</th>
                    <th>Cliente</th>
                    <th>Vendedor</th>
                    <th>Pagamento</th>
                    <th class="numero">Total</th>
                </tr>
            </thead>
            <tbody>
                {{#each vendas}}
                <tr>
                    <td>{{data data}}</td>
                    <td class="text-zinc-100">{{#if cliente}}{{cliente.nome}}{{else}}Consumidor final{{/if}}</td>
                    <td>{{#if funcionario}}{{funcionario.nome}}{{else}}<span class="text-zinc-600">—</span>{{/if}}</td>
                    <td><span class="selo selo-azul">{{formaPagamento}}</span></td>
                    <td class="numero font-semibold text-zinc-100">{{moeda valorTotal}}</td>
                </tr>
                {{#if itens.length}}
                <tr>
                    <td colspan="5" class="!py-2 bg-zinc-950/40">
                        <p class="text-xs text-zinc-500">
                            <i class="bi bi-box-seam mr-1"></i>
                            {{#each itens}}{{quantidade}}x {{descricao}} ({{moeda precoUnitario}}){{#unless @last}} · {{/unless}}{{/each}}
                        </p>
                        {{#if observacoes}}<p class="text-xs text-zinc-600 italic mt-1">{{observacoes}}</p>{{/if}}
                    </td>
                </tr>
                {{/if}}
                {{else}}
                <tr>
                    <td colspan="5">
                        <div class="tabela-vazia">
                            <i class="bi bi-bag-x text-3xl block mb-2 text-zinc-600"></i>
                            Nenhuma venda registrada neste período.
                            <div class="mt-3"><a href="/admin/vendas/nova" class="botao botao-primario botao-mini">Registrar venda</a></div>
                        </div>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>
