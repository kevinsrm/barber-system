<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-5">
    <div>
        <p class="text-[11px] font-semibold uppercase tracking-widest text-amber-500">Financeiro</p>
        <h2 class="text-xl sm:text-2xl font-bold text-white">Comissões por barbeiro</h2>
        <p class="text-sm text-zinc-500 mt-0.5">Serviços concluídos + vendas do período.</p>
    </div>
    <a href="/admin/relatorios/comissoes" class="botao botao-secundario"><i class="bi bi-file-earmark-text"></i> Abrir relatório</a>
</div>

{{> admin/filtro-periodo}}

<div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
    <div class="cartao p-4">
        <p class="text-[11px] uppercase tracking-wider text-zinc-500">Atendimentos concluídos</p>
        <p class="text-xl font-bold text-white mt-1">{{totais.atendimentos}}</p>
    </div>
    <div class="cartao p-4">
        <p class="text-[11px] uppercase tracking-wider text-zinc-500">Base de cálculo</p>
        <p class="text-xl font-bold text-white mt-1">{{moeda totais.base}}</p>
    </div>
    <div class="cartao p-4">
        <p class="text-[11px] uppercase tracking-wider text-zinc-500">Comissões a pagar</p>
        <p class="text-xl font-bold text-amber-400 mt-1">{{moeda totais.comissoes}}</p>
    </div>
</div>

<div class="cartao overflow-hidden">
    <div class="overflow-x-auto">
        <table class="tabela min-w-[820px]">
            <thead>
                <tr>
                    <th>Barbeiro</th>
                    <th>Cargo</th>
                    <th class="numero">Atendimentos</th>
                    <th class="numero">Serviços (R$)</th>
                    <th class="numero">Vendas (R$)</th>
                    <th class="numero">Comissão</th>
                    <th class="numero">Valor</th>
                </tr>
            </thead>
            <tbody>
                {{#each resumos}}
                <tr>
                    <td class="font-medium text-zinc-100">{{nome}}</td>
                    <td>{{cargo}}</td>
                    <td class="numero">{{atendimentos}}</td>
                    <td class="numero">{{moeda totalServicos}}</td>
                    <td class="numero">{{moeda totalVendas}}</td>
                    <td class="numero">{{numero percentual 0}}%</td>
                    <td class="numero font-bold text-amber-400">{{moeda valorComissao}}</td>
                </tr>
                {{else}}
                <tr>
                    <td colspan="7">
                        <div class="tabela-vazia">
                            <i class="bi bi-percent text-3xl block mb-2 text-zinc-600"></i>
                            Nenhum barbeiro ativo cadastrado.
                        </div>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>

<p class="text-xs text-zinc-500 mt-3">
    <i class="bi bi-info-circle"></i>
    O percentual de cada barbeiro é definido em <a href="/admin/funcionarios" class="text-amber-500 hover:underline">Funcionários</a>.
    Somente atendimentos com status <strong>Concluído</strong> entram no cálculo.
</p>
