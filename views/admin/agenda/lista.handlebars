<!-- Cabeçalho -->
<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-5">
    <div>
        <p class="text-[11px] font-semibold uppercase tracking-widest text-amber-500">Agenda</p>
        <h2 class="text-xl sm:text-2xl font-bold text-white">Agendamentos</h2>
        <p class="text-sm text-zinc-500 mt-0.5">Atendimentos de {{dataLonga data}}</p>
    </div>
    <a href="/admin/agendamentos/novo" class="botao botao-primario"><i class="bi bi-plus-lg"></i> Novo agendamento</a>
</div>

<!-- Resumo do dia -->
<div class="grid grid-cols-2 lg:grid-cols-5 gap-3 mb-4">
    <div class="cartao p-3">
        <p class="text-[11px] uppercase tracking-wider text-zinc-500">Total</p>
        <p class="text-xl font-bold text-white">{{resumo.total}}</p>
    </div>
    <div class="cartao p-3">
        <p class="text-[11px] uppercase tracking-wider text-zinc-500">Pendentes</p>
        <p class="text-xl font-bold text-amber-400">{{resumo.pendentes}}</p>
    </div>
    <div class="cartao p-3">
        <p class="text-[11px] uppercase tracking-wider text-zinc-500">Confirmados</p>
        <p class="text-xl font-bold text-sky-400">{{resumo.confirmados}}</p>
    </div>
    <div class="cartao p-3">
        <p class="text-[11px] uppercase tracking-wider text-zinc-500">Concluídos</p>
        <p class="text-xl font-bold text-emerald-400">{{resumo.concluidos}}</p>
    </div>
    <div class="cartao p-3 col-span-2 lg:col-span-1">
        <p class="text-[11px] uppercase tracking-wider text-zinc-500">Valor previsto</p>
        <p class="text-xl font-bold text-white">{{moeda resumo.valor}}</p>
    </div>
</div>

<!-- Filtros -->
<form method="GET" action="/admin/agendamentos" class="cartao p-4 mb-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 items-end">
    <div>
        <label for="data" class="rotulo">Data</label>
        <input type="date" id="data" name="data" value="{{data}}" class="campo">
    </div>
    <div>
        <label for="status" class="rotulo">Status</label>
        <select id="status" name="status" class="campo-select">
            <option value="">Todos</option>
            <option value="pendente" {{#if (eq status 'pendente')}}selected{{/if}}>Pendente</option>
            <option value="confirmado" {{#if (eq status 'confirmado')}}selected{{/if}}>Confirmado</option>
            <option value="concluido" {{#if (eq status 'concluido')}}selected{{/if}}>Concluído</option>
            <option value="cancelado" {{#if (eq status 'cancelado')}}selected{{/if}}>Cancelado</option>
        </select>
    </div>
    <div>
        <label for="funcionarioId" class="rotulo">Barbeiro</label>
        <select id="funcionarioId" name="funcionarioId" class="campo-select">
            <option value="">Todos</option>
            {{#each funcionarios}}
            <option value="{{id}}" {{#if (eq ../funcionarioId id)}}selected{{/if}}>{{nome}}</option>
            {{/each}}
        </select>
    </div>
    <div class="flex gap-2">
        <button type="submit" class="botao botao-primario flex-1"><i class="bi bi-funnel"></i> Filtrar</button>
        <a href="/admin/agendamentos" class="botao botao-secundario" title="Limpar filtros"><i class="bi bi-arrow-clockwise"></i></a>
    </div>
</form>

<!-- Lista -->
<div class="cartao overflow-hidden">
    <div class="overflow-x-auto">
        <table class="tabela min-w-[900px]">
            <thead>
                <tr>
                    <th>Hora</th>
                    <th>Cliente</th>
                    <th>Barbeiro</th>
                    <th>Serviços</th>
                    <th>Valor</th>
                    <th>Status</th>
                    <th class="text-right">Alterar status</th>
                </tr>
            </thead>
            <tbody>
                {{#each agendamentos}}
                <tr>
                    <td class="font-bold text-amber-400">{{hora hora}}</td>
                    <td>
                        <p class="font-medium text-zinc-100">{{cliente.nome}}</p>
                        <p class="text-xs text-zinc-500">{{#if cliente.telefone}}{{cliente.telefone}}{{/if}}</p>
                    </td>
                    <td>{{funcionario.nome}}</td>
                    <td>
                        <span class="text-xs text-zinc-400">
                            {{#each itens}}{{nomeServico}}{{#unless @last}} · {{/unless}}{{/each}}
                        </span>
                    </td>
                    <td class="numero">{{moeda valorTotal}}</td>
                    <td><span class="selo {{corStatus status}}">{{rotuloStatus status}}</span></td>
                    <td>
                        <form method="POST" action="/admin/agendamentos/{{id}}/status" class="flex items-center justify-end gap-2">
                            <select name="status" class="campo-select w-36 py-1.5 text-xs" aria-label="Status do agendamento">
                                <option value="pendente" {{#if (eq status 'pendente')}}selected{{/if}}>Pendente</option>
                                <option value="confirmado" {{#if (eq status 'confirmado')}}selected{{/if}}>Confirmado</option>
                                <option value="concluido" {{#if (eq status 'concluido')}}selected{{/if}}>Concluído</option>
                                <option value="cancelado" {{#if (eq status 'cancelado')}}selected{{/if}}>Cancelado</option>
                            </select>
                            <button type="submit" class="botao botao-icone" title="Salvar status"><i class="bi bi-check2"></i></button>
                        </form>
                    </td>
                </tr>
                {{else}}
                <tr>
                    <td colspan="7">
                        <div class="tabela-vazia">
                            <i class="bi bi-calendar-x text-3xl block mb-2 text-zinc-600"></i>
                            Nenhum agendamento para os filtros escolhidos.
                            <div class="mt-3"><a href="/admin/agendamentos/novo" class="botao botao-primario botao-mini">Criar agendamento</a></div>
                        </div>
                    </td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
</div>
