<div class="space-y-6">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-white">Retorno de clientes</h1>
      <p class="text-sm text-zinc-400">Quem está há mais tempo sem voltar para a barbearia.</p>
    </div>
    <a href="/admin/clientes" class="inline-flex items-center justify-center gap-2 rounded-lg bg-zinc-800 px-4 py-2 text-sm font-semibold text-zinc-200 transition hover:bg-zinc-700">
      <i class="bi bi-people"></i> Ver clientes
    </a>
  </div>

  <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-4">
      <p class="text-xs uppercase tracking-wide text-zinc-500">Clientes</p>
      <p class="mt-1 text-2xl font-bold text-white">{{resumo.total}}</p>
    </div>
    <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-4">
      <p class="text-xs uppercase tracking-wide text-zinc-500">Em dia</p>
      <p class="mt-1 text-2xl font-bold text-emerald-400">{{resumo.emDia}}</p>
      <p class="text-xs text-zinc-500">últimos 30 dias</p>
    </div>
    <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-4">
      <p class="text-xs uppercase tracking-wide text-zinc-500">Atenção</p>
      <p class="mt-1 text-2xl font-bold text-amber-400">{{resumo.atencao}}</p>
      <p class="text-xs text-zinc-500">31 a 60 dias</p>
    </div>
    <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-4">
      <p class="text-xs uppercase tracking-wide text-zinc-500">Sem retorno</p>
      <p class="mt-1 text-2xl font-bold text-red-400">{{resumo.semRetorno}}</p>
      <p class="text-xs text-zinc-500">nunca voltou ou +60 dias</p>
    </div>
  </div>

  <div class="overflow-hidden rounded-xl border border-zinc-800">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-zinc-800 text-sm">
        <thead class="bg-zinc-900 text-xs uppercase tracking-wide text-zinc-500">
          <tr>
            <th class="px-4 py-3 text-left">Cliente</th>
            <th class="px-4 py-3 text-left">WhatsApp</th>
            <th class="px-4 py-3 text-center">Visitas</th>
            <th class="px-4 py-3 text-center">Última visita</th>
            <th class="px-4 py-3 text-center">Sem voltar</th>
            <th class="px-4 py-3 text-right">Total gasto</th>
            <th class="px-4 py-3 text-right">Contato</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-800 bg-zinc-950">
          {{#each clientes}}
            <tr class="hover:bg-zinc-900/60">
              <td class="px-4 py-3 font-medium text-zinc-100">{{nome}}</td>
              <td class="px-4 py-3 text-zinc-400">{{#if telefone}}{{telefone}}{{else}}—{{/if}}</td>
              <td class="px-4 py-3 text-center text-zinc-300">{{visitas}}</td>
              <td class="px-4 py-3 text-center text-zinc-300">{{#if ultimaVisita}}{{data ultimaVisita}}{{else}}—{{/if}}</td>
              <td class="px-4 py-3 text-center">
                {{#if diasSemVoltar}}
                  <span class="inline-flex rounded-full px-2 py-1 text-xs font-semibold {{#if (lte diasSemVoltar 30)}}bg-emerald-500/10 text-emerald-400{{else if (lte diasSemVoltar 60)}}bg-amber-500/10 text-amber-400{{else}}bg-red-500/10 text-red-400{{/if}}">
                    {{diasSemVoltar}} dias
                  </span>
                {{else}}
                  <span class="inline-flex rounded-full bg-zinc-700/40 px-2 py-1 text-xs font-semibold text-zinc-300">sem visita</span>
                {{/if}}
              </td>
              <td class="px-4 py-3 text-right text-zinc-300">{{moeda totalGasto}}</td>
              <td class="px-4 py-3 text-right">
                {{#if telefone}}
                  <a href="https://wa.me/55{{digitos telefone}}" target="_blank" rel="noopener" class="inline-flex items-center gap-1 rounded-lg bg-emerald-600/20 px-3 py-1.5 text-xs font-semibold text-emerald-300 transition hover:bg-emerald-600/30">
                    <i class="bi bi-whatsapp"></i> Chamar
                  </a>
                {{else}}
                  <span class="text-xs text-zinc-600">sem telefone</span>
                {{/if}}
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="7" class="px-4 py-10 text-center text-zinc-500">Nenhum cliente cadastrado ainda.</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>

  <p class="text-xs text-zinc-500">
    A última visita considera apenas agendamentos com status <strong class="text-zinc-300">concluído</strong>.
  </p>
</div>
