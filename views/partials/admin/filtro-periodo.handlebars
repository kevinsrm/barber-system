<form method="GET" action="{{caminhoAtual}}" class="cartao p-4 mb-4 flex flex-col sm:flex-row sm:items-end gap-3 sm:max-w-xl">
    <div class="flex-1">
        <label for="inicio" class="rotulo">De</label>
        <input type="date" id="inicio" name="inicio" value="{{inicio}}" class="campo">
    </div>
    <div class="flex-1">
        <label for="fim" class="rotulo">Até</label>
        <input type="date" id="fim" name="fim" value="{{fim}}" class="campo">
    </div>
    <button type="submit" class="botao botao-secundario"><i class="bi bi-funnel"></i> Filtrar</button>
</form>
