<a href="{{href}}" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm border transition
    {{#if ativo}}bg-amber-500/10 text-amber-400 border-amber-500/25
    {{else}}text-zinc-400 border-transparent hover:text-zinc-100 hover:bg-zinc-900{{/if}}">
    <i class="bi {{icone}} text-base"></i>
    <span class="truncate">{{rotulo}}</span>
</a>
