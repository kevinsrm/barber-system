<header class="bg-zinc-950/95 border-b border-zinc-800/80 sticky top-0 z-50 backdrop-blur-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between gap-4">

        <!-- Logo / nome da barbearia -->
        <a href="/" class="flex items-center gap-3 group shrink-0" aria-label="{{site.nome}} — página inicial">
            {{#if site.logo}}
                <img src="{{site.logo}}" alt="Logo {{site.nome}}" class="h-11 w-auto max-w-[160px] object-contain">
            {{else}}
                <span class="w-11 h-11 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 group-hover:bg-amber-500 group-hover:text-zinc-950 transition-all duration-300">
                    <i class="bi bi-scissors text-xl"></i>
                </span>
            {{/if}}
            <span class="min-w-0">
                <span class="block font-black text-lg sm:text-xl tracking-tight text-white leading-tight truncate">{{site.nome}}</span>
                <span class="block text-[11px] uppercase tracking-[0.18em] text-zinc-500 truncate">{{site.slogan}}</span>
            </span>
        </a>

        <!-- Menu desktop -->
        <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-zinc-300" aria-label="Menu principal">
            <a href="/" class="hover:text-amber-400 transition-colors">Início</a>
            <a href="/servicos" class="hover:text-amber-400 transition-colors">Serviços</a>
            <a href="/#como-funciona" class="hover:text-amber-400 transition-colors">Como funciona</a>
            <a href="/#contato" class="hover:text-amber-400 transition-colors">Contato</a>

            {{#if usuario}}
                {{#if (eq usuario.role 'admin')}}
                    <a href="/admin" class="hover:text-amber-400 transition-colors inline-flex items-center gap-1.5"><i class="bi bi-speedometer2"></i> Painel</a>
                {{else if (eq usuario.role 'barbeiro')}}
                    <a href="/painel" class="hover:text-amber-400 transition-colors inline-flex items-center gap-1.5"><i class="bi bi-calendar-week"></i> Meu painel</a>
                {{else}}
                    <a href="/minhas-reservas" class="hover:text-amber-400 transition-colors inline-flex items-center gap-1.5"><i class="bi bi-calendar-check"></i> Minhas reservas</a>
                {{/if}}
                <a href="/logout" class="text-zinc-500 hover:text-rose-400 transition-colors" title="Sair">Sair</a>
            {{else}}
                <a href="/login" class="hover:text-amber-400 transition-colors">Entrar</a>
            {{/if}}
        </nav>

        <!-- Botão de agendamento (desktop) -->
        <div class="hidden md:flex items-center">
            <a href="/agendar" class="bg-amber-500 hover:bg-amber-400 text-zinc-950 font-bold px-5 py-2.5 rounded-xl shadow-md shadow-amber-500/10 transition text-sm inline-flex items-center gap-2">
                <i class="bi bi-calendar-check-fill"></i> Agendar
            </a>
        </div>

        <!-- Botão hambúrguer (mobile) -->
        <button id="btn-menu-mobile" type="button" class="md:hidden w-11 h-11 rounded-lg border border-zinc-800 text-zinc-300 hover:text-amber-400 transition flex items-center justify-center" aria-label="Abrir menu" aria-controls="mobile-menu" aria-expanded="false">
            <i class="bi bi-list text-2xl" id="icon-menu"></i>
        </button>
    </div>

    <!-- Menu mobile -->
    <div id="mobile-menu" class="hidden md:hidden bg-zinc-950 border-t border-zinc-800 px-4 pt-3 pb-5 space-y-1">
        <a href="/" class="flex items-center gap-3 text-zinc-200 hover:text-amber-400 font-medium py-3 border-b border-zinc-800/60">
            <i class="bi bi-house-door text-amber-400"></i> Início
        </a>
        <a href="/servicos" class="flex items-center gap-3 text-zinc-200 hover:text-amber-400 font-medium py-3 border-b border-zinc-800/60">
            <i class="bi bi-scissors text-amber-400"></i> Serviços e preços
        </a>
        <a href="/#como-funciona" class="flex items-center gap-3 text-zinc-200 hover:text-amber-400 font-medium py-3 border-b border-zinc-800/60">
            <i class="bi bi-info-circle text-amber-400"></i> Como funciona
        </a>
        <a href="/#contato" class="flex items-center gap-3 text-zinc-200 hover:text-amber-400 font-medium py-3 border-b border-zinc-800/60">
            <i class="bi bi-geo-alt text-amber-400"></i> Contato
        </a>

        {{#if usuario}}
            {{#if (eq usuario.role 'admin')}}
                <a href="/admin" class="flex items-center gap-3 text-zinc-200 hover:text-amber-400 font-medium py-3 border-b border-zinc-800/60">
                    <i class="bi bi-speedometer2 text-amber-400"></i> Painel administrativo
                </a>
            {{else if (eq usuario.role 'barbeiro')}}
                <a href="/painel" class="flex items-center gap-3 text-zinc-200 hover:text-amber-400 font-medium py-3 border-b border-zinc-800/60">
                    <i class="bi bi-calendar-week text-amber-400"></i> Meu painel
                </a>
            {{else}}
                <a href="/minhas-reservas" class="flex items-center gap-3 text-zinc-200 hover:text-amber-400 font-medium py-3 border-b border-zinc-800/60">
                    <i class="bi bi-calendar-check text-amber-400"></i> Minhas reservas
                </a>
            {{/if}}
            <a href="/logout" class="flex items-center gap-3 text-zinc-400 hover:text-rose-400 font-medium py-3 border-b border-zinc-800/60">
                <i class="bi bi-box-arrow-right"></i> Sair
            </a>
        {{else}}
            <a href="/login" class="flex items-center gap-3 text-zinc-200 hover:text-amber-400 font-medium py-3 border-b border-zinc-800/60">
                <i class="bi bi-box-arrow-in-right text-amber-400"></i> Entrar
            </a>
        {{/if}}

        <div class="pt-3">
            <a href="/agendar" class="w-full bg-amber-500 hover:bg-amber-400 text-zinc-950 font-bold py-3 rounded-xl transition inline-flex items-center justify-center gap-2">
                <i class="bi bi-calendar-check-fill"></i> Agendar horário
            </a>
        </div>
    </div>
</header>
