<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{#if seo.titulo}}{{seo.titulo}}{{else}}{{site.nome}}{{/if}}</title>
    <meta name="description" content="Acesse sua conta na {{site.nome}}.">
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#09090b">
    {{#if site.logo}}
    <link rel="icon" href="{{site.logo}}">
    {{else}}
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    {{/if}}
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-zinc-950 text-zinc-100 antialiased min-h-screen">

    <div class="min-h-screen flex flex-col">
        <!-- Cabeçalho simples com a logo -->
        <header class="border-b border-zinc-800/80">
            <div class="max-w-6xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between">
                <a href="/" class="flex items-center gap-3 group" aria-label="Voltar para o site">
                    {{#if site.logo}}
                        <img src="{{site.logo}}" alt="Logo {{site.nome}}" class="h-10 w-auto rounded-lg">
                    {{else}}
                        <span class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 group-hover:bg-amber-500 group-hover:text-zinc-950 transition">
                            <i class="bi bi-scissors text-xl"></i>
                        </span>
                    {{/if}}
                    <span class="font-black text-lg tracking-tight text-white">{{site.nome}}</span>
                </a>
                <a href="/" class="text-sm text-zinc-400 hover:text-amber-400 inline-flex items-center gap-2">
                    <i class="bi bi-arrow-left"></i> Voltar ao site
                </a>
            </div>
        </header>

        <main class="flex-1 flex items-center justify-center px-4 py-10 sm:py-16">
            {{{body}}}
        </main>

        <footer class="border-t border-zinc-800/80 py-6 text-center text-xs text-zinc-500">
            © {{anoAtual}} {{site.nome}} · Todos os direitos reservados
        </footer>
    </div>

    {{> components/flash}}
    <script src="/js/app.js"></script>
</body>
</html>
