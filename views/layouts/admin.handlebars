<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{#if titulo}}{{titulo}} | {{/if}}Painel · {{site.nome}}</title>
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#09090b">
    {{#if site.logo}}
    <link rel="icon" href="{{site.logo}}">
    {{else}}
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
    {{/if}}
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-zinc-950 text-zinc-100 antialiased min-h-screen">

    <div class="min-h-screen lg:flex">
        <!-- Menu lateral -->
        <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-72 bg-zinc-950 border-r border-zinc-800 overflow-y-auto -translate-x-full lg:translate-x-0 transition-transform duration-300">
            {{> admin/sidebar}}
        </aside>

        <!-- Fundo escuro do menu no celular -->
        <div id="sidebar-overlay" class="hidden lg:hidden fixed inset-0 bg-black/70 z-40"></div>

        <div class="flex-1 lg:pl-72 flex flex-col min-h-screen">
            <!-- Cabeçalho do painel -->
            <header class="sticky top-0 z-30 bg-zinc-950/95 backdrop-blur border-b border-zinc-800">
                <div class="h-16 px-4 sm:px-6 flex items-center justify-between gap-3">
                    <div class="flex items-center gap-3 min-w-0">
                        <button id="btn-sidebar" type="button" class="lg:hidden w-10 h-10 rounded-lg border border-zinc-800 text-zinc-300 hover:text-amber-400 hover:border-amber-500/40 transition" aria-label="Abrir menu">
                            <i class="bi bi-list text-xl"></i>
                        </button>
                        <div class="min-w-0">
                            <p class="text-[11px] uppercase tracking-wider text-zinc-500">{{#if (eq usuario.role 'barbeiro')}}Área do barbeiro{{else}}Administração{{/if}}</p>
                            <h1 class="text-sm sm:text-base font-semibold text-zinc-100 truncate">{{titulo}}</h1>
                        </div>
                    </div>

                    <div class="flex items-center gap-2 sm:gap-3">
                        <a href="/" target="_blank" rel="noopener" class="hidden sm:inline-flex items-center gap-2 text-xs text-zinc-400 hover:text-amber-400 border border-zinc-800 rounded-lg px-3 py-2 transition">
                            <i class="bi bi-globe2"></i> Ver site
                        </a>
                        <div class="hidden md:flex items-center gap-2">
                            <span class="w-9 h-9 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold flex items-center justify-center">
                                {{iniciais usuario.nome}}
                            </span>
                            <div class="leading-tight">
                                <p class="text-xs font-semibold text-zinc-200">{{usuario.nome}}</p>
                                <p class="text-[11px] text-zinc-500">{{#if (eq usuario.role 'admin')}}Administrador{{else}}Barbeiro{{/if}}</p>
                            </div>
                        </div>
                        <a href="/logout" class="w-10 h-10 rounded-lg border border-zinc-800 text-zinc-400 hover:text-rose-400 hover:border-rose-500/40 transition flex items-center justify-center" title="Sair">
                            <i class="bi bi-box-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </header>

            <main class="flex-1 p-4 sm:p-6 lg:p-8">
                {{> components/flash}}
                {{{body}}}
            </main>

            <footer class="px-4 sm:px-6 py-5 border-t border-zinc-800 text-xs text-zinc-500 flex flex-col sm:flex-row gap-2 items-center justify-between">
                <span>© {{anoAtual}} {{site.nome}} — Painel do sistema</span>
                <span class="inline-flex items-center gap-1.5"><i class="bi bi-shield-check"></i> Área restrita</span>
            </footer>
        </div>
    </div>

    <script src="/js/app.js"></script>
</body>
</html>
